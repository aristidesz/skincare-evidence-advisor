# Copy to .env and adjust. .env is gitignored.

# Which provider to use: ollama (local, free) or openrouter (hosted)
LLM_PROVIDER=ollama

# Optional overrides for Ollama
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenRouter: get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
